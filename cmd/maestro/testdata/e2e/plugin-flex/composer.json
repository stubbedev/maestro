{
    "name": "maestro-test/flex",
    "description": "symfony/flex 2.11.0 with a local recipes endpoint: recipes, symfony.lock, alias resolution (req logger), pack unpacking, its commands added to the running Application.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "php": ">=8.1",
        "maestro-test/demo-pack": "1.0.0",
        "symfony/flex": "2.11.0"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        },
        "sort-packages": true,
        "secure-http": false
    },
    "extra": {
        "symfony": {
            "endpoint": [
                "@ENDPOINT@/index.json"
            ]
        }
    }
}
