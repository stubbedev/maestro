{
    "name": "maestro/e2e",
    "description": "A project maestro and Composer must install identically.",
    "require": {
        "monolog/monolog": "^3.0",
        "symfony/console": "^7.0",
        "guzzlehttp/guzzle": "^7.8",
        "nesbot/carbon": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"file_put_contents('post-install-ran', 'yes');\""
        ],
        "post-autoload-dump": [
            "@php -r \"file_put_contents('autoload-dumped', 'yes');\""
        ]
    }
}
