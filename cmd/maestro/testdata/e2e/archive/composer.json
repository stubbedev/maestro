{
    "name": "maestro/archive",
    "description": "A project maestro and Composer must archive identically.",
    "require": {
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "archive": {
        "exclude": ["/excluded.txt"]
    },
    "config": {
        "archive-format": "zip",
        "archive-dir": "../archives"
    }
}
