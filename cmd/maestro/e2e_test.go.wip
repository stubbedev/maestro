//go:build unix

package main

import (
	"bytes"
	"crypto/sha256"
	"fmt"
	"io/fs"
	"os"
	"os/exec"
	"path/filepath"
	"strings"
	"testing"
	"time"

)

// step is one composer command line run in a fixture, with extra environment.
type step struct {
	env  []string
	args []string
}

// fixtures are the projects under testdata/e2e, each installed in steps.
var fixtures = map[string][]step{
	"basic":   {{args: []string{"install"}}},
	"nodev":   {{args: []string{"install", "--no-dev"}}},
	"plugins": {{args: []string{"install"}}},
	"upgrade": {
		{env: []string{"COMPOSER=composer.json.before"}, args: []string{"install"}},
		{args: []string{"install"}},
	},
}

// TestInstallsMatchComposer is the drop-in promise, checked end to end: each
// fixture installed by the bundled composer.phar alone and by maestro, from a
// cold store and from a warm one (a second worktree), must give identical
// trees, down to modes, link targets and the mtimes unzip set, and maestro
// must have supplied every package itself.
//
// It needs php, unzip and the network, so it only runs with MAESTRO_E2E=1.
func TestInstallsMatchComposer(t *testing.T) {
	if os.Getenv("MAESTRO_E2E") == "" {
		t.Skip("set MAESTRO_E2E=1 to install real packages with php, unzip and the network")
	}

	for _, tool := range []string{"php", "unzip"} {
		if _, err := exec.LookPath(tool); err != nil {
			t.Fatalf("%s is required: %v", tool, err)
		}
	}

	root := t.TempDir()
	maestro := buildMaestro(t, root)
	phar := filepath.Join(root, "composer.phar")

	data, err := os.ReadFile("../../internal/runtime/composer.phar")
	if err != nil {
		t.Fatal(err)
	}

	if err := os.WriteFile(phar, data, 0o644); err != nil {
		t.Fatal(err)
	}

	for name, steps := range fixtures {
		t.Run(name, func(t *testing.T) {
			root := t.TempDir()

			// Separate Composer caches, so maestro cannot borrow the archives
			// the plain install downloaded and has to supply them itself.
			env := func(run string, extra []string) []string {
				return append(append(os.Environ(),
					"COMPOSER_CACHE_DIR="+filepath.Join(root, "composer-cache-"+run),
					"MAESTRO_CACHE_DIR="+filepath.Join(root, "maestro-cache"),
					"COMPOSER_NO_INTERACTION=1",
				), extra...)
			}

			runs := []struct {
				name string
				cmd  []string
			}{
				{"plain", []string{"php", phar}},
				{"cold", []string{maestro}},
				{"warm", []string{maestro}},
			}

			for _, r := range runs {
				dir := project(t, root, name, r.name)

				start := time.Now()

				for _, s := range steps {
					runIn(t, dir, env(r.name, s.env), r.cmd[0], append(r.cmd[1:], s.args...)...)
				}

				t.Logf("%-6s %s", r.name, time.Since(start).Round(time.Millisecond))
			}

			// Composer only fills its own cache when it downloads, so an empty
			// one proves every package came out of maestro's staging.
			if n := countFiles(t, filepath.Join(root, "composer-cache-plain", "files")); n == 0 {
				t.Fatal("expected the plain install to fill Composer's cache, or the next check means nothing")
			}

			for _, run := range []string{"cold", "warm"} {
				if n := countFiles(t, filepath.Join(root, "composer-cache-"+run, "files")); n != 0 {
					t.Errorf("maestro (%s store) let Composer download %d archives itself", run, n)
				}
			}

			want := snapshot(t, filepath.Join(root, "plain"))

			for _, run := range []string{"cold", "warm"} {
				if diff := compare(want, snapshot(t, filepath.Join(root, run))); diff != "" {
					t.Errorf("the %s install differs from Composer's:\n%s", run, diff)
				}
			}
		})
	}
}

func countFiles(t *testing.T, dir string) int {
	t.Helper()

	n := 0

	err := filepath.WalkDir(dir, func(_ string, d fs.DirEntry, err error) error {
		if err == nil && d.Type().IsRegular() {
			n++
		}

		return err
	})
	if err != nil && !os.IsNotExist(err) {
		t.Fatal(err)
	}

	return n
}

func buildMaestro(t *testing.T, root string) string {
	t.Helper()

	bin := filepath.Join(root, "maestro")

	cmd := exec.Command("go", "build", "-o", bin, ".")
	cmd.Env = append(os.Environ(), "CGO_ENABLED=0")

	if out, err := cmd.CombinedOutput(); err != nil {
		t.Fatalf("building maestro: %v\n%s", err, out)
	}

	return bin
}

// project copies testdata/e2e/<fixture> to root/<name>.
func project(t *testing.T, root, fixture, name string) string {
	t.Helper()

	src := filepath.Join("testdata", "e2e", fixture)
	dir := filepath.Join(root, name)

	if err := os.CopyFS(dir, os.DirFS(src)); err != nil {
		t.Fatal(err)
	}

	return dir
}

func runIn(t *testing.T, dir string, env []string, name string, args ...string) {
	t.Helper()

	cmd := exec.Command(name, args...)
	cmd.Dir = dir
	cmd.Env = env

	var out bytes.Buffer
	cmd.Stdout = &out
	cmd.Stderr = &out

	if err := cmd.Run(); err != nil {
		t.Fatalf("%s %s in %s: %v\n%s", name, strings.Join(args, " "), dir, err, out.String())
	}
}

// entry is what an install must reproduce for one path.
type entry struct {
	kind  string
	mode  fs.FileMode
	mtime int64 // only for files that come out of a package archive
	sum   [32]byte
	link  string
}

func (e entry) String() string {
	return fmt.Sprintf("%s %v mtime=%d sum=%x link=%q", e.kind, e.mode, e.mtime, e.sum[:4], e.link)
}

// generated lists what Composer writes during the install itself, whose
// mtimes are the moment of writing: they are compared by content and mode.
func generated(rel string) bool {
	return strings.HasPrefix(rel, "vendor/composer/") ||
		strings.HasPrefix(rel, "vendor/bin/") ||
		rel == "vendor/autoload.php" ||
		!strings.HasPrefix(rel, "vendor/")
}

func snapshot(t *testing.T, dir string) map[string]entry {
	t.Helper()

	tree := map[string]entry{}

	err := filepath.WalkDir(dir, func(path string, d fs.DirEntry, err error) error {
		if err != nil {
			return err
		}

		rel, _ := filepath.Rel(dir, path)
		rel = filepath.ToSlash(rel)

		if rel == "." {
			return nil
		}

		info, err := d.Info()
		if err != nil {
			return err
		}

		e := entry{mode: info.Mode()}

		switch {
		case info.Mode()&fs.ModeSymlink != 0:
			e.kind = "link"
			e.mode = 0

			if e.link, err = os.Readlink(path); err != nil {
				return err
			}
		case info.IsDir():
			e.kind = "dir"
		default:
			e.kind = "file"

			data, err := os.ReadFile(path)
			if err != nil {
				return err
			}

			e.sum = sha256.Sum256(data)

			if !generated(rel) {
				e.mtime = info.ModTime().Unix()
			}
		}

		tree[rel] = e

		return nil
	})
	if err != nil {
		t.Fatal(err)
	}

	if len(tree) < 100 {
		t.Fatalf("expected a full install in %s, found %d entries", dir, len(tree))
	}

	return tree
}

func compare(want, got map[string]entry) string {
	var b strings.Builder

	shown := 0

	report := func(format string, args ...any) {
		if shown++; shown <= 20 {
			fmt.Fprintf(&b, format+"\n", args...)
		}
	}

	for path, w := range want {
		g, ok := got[path]

		switch {
		case !ok:
			report("missing %s", path)
		case g != w:
			report("%s\n  want %v\n  got  %v", path, w, g)
		}
	}

	for path := range got {
		if _, ok := want[path]; !ok {
			report("extra %s", path)
		}
	}

	if shown > 20 {
		fmt.Fprintf(&b, "... and %d more\n", shown-20)
	}

	return b.String()
}

