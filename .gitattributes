# Auto detect text files and perform LF normalization; check them out with
# LF everywhere, as the fixtures, expected outputs and generated PHP are
# compared byte for byte (a Windows checkout would otherwise get CRLF).
* text=auto eol=lf

# Go files
*.go text eol=lf

# Shell scripts
*.sh text eol=lf

# Markdown
*.md text

# JSON
*.json text

# YAML
*.yml text
*.yaml text

# Exclude from exports
.gitattributes export-ignore
.gitignore export-ignore
.github export-ignore
